{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Notewise",
  "version": "0.1.0",
  "identifier": "dev.notewise.app",
  "build": {
    "frontendDist": "../dist",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "app", "nsis", "msi", "deb", "appimage"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": ["../dist"],
    "shortDescription": "Local-first meeting intelligence",
    "longDescription": "Records, transcribes, and understands meetings on your own machine.",
    "category": "Productivity",
    "copyright": "Notewise contributors",
    "macOS": {
      "minimumSystemVersion": "13.0"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "linux": {
      "deb": {
        "depends": []
      }
    }
  }
}
